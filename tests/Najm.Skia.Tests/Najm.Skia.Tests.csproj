<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../TestAssemblyConfiguration.cs" Link="TestAssemblyConfiguration.cs" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Najm.Skia/Najm.Skia.csproj" />
    <!-- Text lowering is only testable end to end: a real typesetter produces the layout, a text
         node states where it sits, and this backend rasterizes it. The production graph keeps the
         three apart; the test that proves they agree has to see all three. -->
    <ProjectReference Include="../../src/Najm.Lib/Najm.Lib.csproj" />
    <ProjectReference Include="../../src/Najm.Text/Najm.Text.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Najm.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/AllocationProbe.cs" Link="AllocationProbe.cs" />
  </ItemGroup>
</Project>
