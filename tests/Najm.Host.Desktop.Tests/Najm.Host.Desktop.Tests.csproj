    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../TestAssemblyConfiguration.cs" Link="TestAssemblyConfiguration.cs" />
